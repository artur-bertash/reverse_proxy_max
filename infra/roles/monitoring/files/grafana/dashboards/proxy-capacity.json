{
  "uid": "proxy-capacity",
  "title": "Proxy capacity",
  "schemaVersion": 39,
  "version": 1,
  "editable": false,
  "time": {
    "from": "now-30m",
    "to": "now"
  },
  "refresh": "",
  "timezone": "browser",
  "tags": [
    "proxy"
  ],
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": {
          "type": "grafana",
          "uid": "-- Grafana --"
        },
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      },
      {
        "name": "Probes",
        "enable": true,
        "iconColor": "rgba(138, 184, 255, 0.08)",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "expr": "mload_probe",
        "step": "5s",
        "titleFormat": "{{entry}}: {{label}} {{users}} users",
        "tagKeys": "label"
      },
      {
        "name": "Failed probes",
        "enable": true,
        "iconColor": "red",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "expr": "capacity_probe_result{verdict!=\"pass\"}",
        "step": "5s",
        "useValueForTime": true,
        "titleFormat": "{{label}} {{users}} users: {{verdict}}",
        "textFormat": "proxy {{proxy}}, p95 {{p95_ms}} ms, errors {{err_pct}}%",
        "tagKeys": "verdict"
      },
      {
        "name": "Passed probes",
        "enable": true,
        "iconColor": "green",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "expr": "capacity_probe_result{verdict=\"pass\"}",
        "step": "5s",
        "useValueForTime": true,
        "titleFormat": "{{label}} {{users}} users: {{verdict}}",
        "textFormat": "proxy {{proxy}}, p95 {{p95_ms}} ms, errors {{err_pct}}%",
        "tagKeys": "verdict"
      }
    ]
  },
  "panels": [
    {
      "type": "row",
      "id": 100,
      "title": "Runs",
      "collapsed": false,
      "panels": [],
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      }
    },
    {
      "type": "table",
      "id": 101,
      "title": "Runs (click a version to open its run)",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "every saved run in results/, doesnt care about the time picker",
      "gridPos": {
        "h": 5,
        "w": 24,
        "x": 0,
        "y": 1
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "max by (entry) (last_over_time(capacity_run_start_ms[100y] @ 4102444800)) - 30000",
          "instant": true,
          "range": false,
          "format": "table"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "max by (entry) (last_over_time(capacity_run_end_ms[100y] @ 4102444800)) + 30000",
          "instant": true,
          "range": false,
          "format": "table"
        },
        {
          "refId": "C",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "max by (entry) (last_over_time(capacity_score_users[100y] @ 4102444800))",
          "instant": true,
          "range": false,
          "format": "table"
        },
        {
          "refId": "D",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "max by (entry) (last_over_time(capacity_run_start_ms[100y] @ 4102444800))",
          "instant": true,
          "range": false,
          "format": "table"
        },
        {
          "refId": "E",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "max by (entry) (last_over_time(capacity_run_end_ms[100y] @ 4102444800))",
          "instant": true,
          "range": false,
          "format": "table"
        }
      ],
      "transformations": [
        {
          "id": "merge",
          "options": {}
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true
            },
            "indexByName": {
              "entry": 0,
              "Value #C": 1,
              "Value #D": 2,
              "Value #E": 3,
              "Value #A": 4,
              "Value #B": 5
            },
            "renameByName": {
              "entry": "version",
              "Value #C": "score (users, 0 = stopped early)",
              "Value #D": "start",
              "Value #E": "end",
              "Value #A": "start_ms",
              "Value #B": "end_ms"
            }
          }
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "version"
            },
            "properties": [
              {
                "id": "links",
                "value": [
                  {
                    "title": "Open this run",
                    "url": "/d/proxy-capacity/proxy-capacity?from=${__data.fields[\"start_ms\"]}&to=${__data.fields[\"end_ms\"]}"
                  }
                ]
              }
            ]
          },
          {
            "matcher": {
              "id": "byRegexp",
              "options": "^(start|end)$"
            },
            "properties": [
              {
                "id": "unit",
                "value": "dateTimeAsIso"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "start_ms"
            },
            "properties": [
              {
                "id": "custom.hidden",
                "value": true
              },
              {
                "id": "unit",
                "value": "none"
              },
              {
                "id": "decimals",
                "value": 0
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "end_ms"
            },
            "properties": [
              {
                "id": "custom.hidden",
                "value": true
              },
              {
                "id": "unit",
                "value": "none"
              },
              {
                "id": "decimals",
                "value": 0
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "sortBy": [
          {
            "displayName": "start",
            "desc": true
          }
        ]
      }
    },
    {
      "type": "row",
      "id": 102,
      "title": "Load results (mload, every 5 s)",
      "collapsed": false,
      "panels": [],
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 6
      }
    },
    {
      "type": "timeseries",
      "id": 103,
      "title": "Users and connections",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 7
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 10,
            "showPoints": "never"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "mload_users",
          "legendFormat": "{{entry}} users"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "mload_conns",
          "legendFormat": "{{entry}} connections"
        }
      ]
    },
    {
      "type": "timeseries",
      "id": 104,
      "title": "Requests per second",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 7
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 10,
            "showPoints": "never"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "mload_rps",
          "legendFormat": "{{entry}}"
        }
      ],
      "description": "includes the failed ones too"
    },
    {
      "type": "timeseries",
      "id": 105,
      "title": "Latency of successful requests (log scale; limit: p95 < 500 ms, p99 < 1 s)",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 15
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 10,
            "showPoints": "never",
            "scaleDistribution": {
              "type": "log",
              "log": 10
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "mload_p95_ms",
          "legendFormat": "{{entry}} p95"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "mload_p99_ms",
          "legendFormat": "{{entry}} p99"
        }
      ]
    },
    {
      "type": "timeseries",
      "id": 106,
      "title": "Failed requests per 5 s",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 15
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 10,
            "showPoints": "never"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "mload_fails",
          "legendFormat": "{{entry}}"
        }
      ]
    },
    {
      "type": "row",
      "title": "Proxy box",
      "id": 1,
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 23
      }
    },
    {
      "type": "timeseries",
      "title": "Proxy CPU by kind",
      "description": "1 vCPU. 'steal' is time taken by other VMs on the same host.",
      "id": 2,
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 24
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 25,
            "showPoints": "never",
            "stacking": {
              "mode": "normal"
            }
          },
          "max": 100
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "100 * sum by (mode) (rate(node_cpu_seconds_total{server=\"proxy\",mode!=\"idle\"}[$__rate_interval]))",
          "legendFormat": "{{mode}}"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Proxy box memory",
      "description": "When 'available' reaches ~0, the kernel kills the biggest process (the proxy).",
      "id": 3,
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 24
      },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 8,
            "showPoints": "never",
            "stacking": {
              "mode": "none"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "node_memory_MemTotal_bytes{server=\"proxy\"}",
          "legendFormat": "total RAM"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "node_memory_MemAvailable_bytes{server=\"proxy\"}",
          "legendFormat": "available"
        },
        {
          "refId": "C",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "process_resident_memory_bytes{job=\"proxy\"}",
          "legendFormat": "proxy process (RSS)"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Out-of-memory kills and proxy up",
      "description": "An OOM kill shows as a bar; 'up' drops to 0 when the proxy process is gone.",
      "id": 4,
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 32
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 80,
            "showPoints": "never",
            "stacking": {
              "mode": "none"
            },
            "drawStyle": "bars"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "increase(node_vmstat_oom_kill{server=\"proxy\"}[1m])",
          "legendFormat": "OOM kills (last minute)"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "up{job=\"proxy\"}",
          "legendFormat": "proxy /metrics up (1 = yes)"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Pressure (time spent waiting)",
      "description": "Linux PSI: % of time tasks waited for memory or CPU. Rising memory pressure comes before an OOM kill.",
      "id": 5,
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 32
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 8,
            "showPoints": "never",
            "stacking": {
              "mode": "none"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "100 * rate(node_pressure_memory_waiting_seconds_total{server=\"proxy\"}[$__rate_interval])",
          "legendFormat": "memory"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "100 * rate(node_pressure_cpu_waiting_seconds_total{server=\"proxy\"}[$__rate_interval])",
          "legendFormat": "CPU"
        }
      ]
    },
    {
      "type": "row",
      "title": "Go runtime (proxy)",
      "id": 6,
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 40
      }
    },
    {
      "type": "timeseries",
      "title": "Go memory breakdown",
      "description": "Where the Go runtime's memory goes. For *which code* allocated it, take a heap profile (pprof).",
      "id": 7,
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 41
      },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 25,
            "showPoints": "never",
            "stacking": {
              "mode": "normal"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "go_memory_classes_heap_objects_bytes{job=\"proxy\"}",
          "legendFormat": "heap: live + not yet collected objects"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "go_memory_classes_heap_unused_bytes{job=\"proxy\"}",
          "legendFormat": "heap: unused space in spans"
        },
        {
          "refId": "C",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "go_memory_classes_heap_free_bytes{job=\"proxy\"}",
          "legendFormat": "heap: free, not returned to OS"
        },
        {
          "refId": "D",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "go_memory_classes_heap_stacks_bytes{job=\"proxy\"} + go_memory_classes_os_stacks_bytes{job=\"proxy\"}",
          "legendFormat": "goroutine stacks"
        },
        {
          "refId": "E",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "go_memory_classes_total_bytes{job=\"proxy\"} - go_memory_classes_heap_objects_bytes{job=\"proxy\"} - go_memory_classes_heap_unused_bytes{job=\"proxy\"} - go_memory_classes_heap_free_bytes{job=\"proxy\"} - go_memory_classes_heap_released_bytes{job=\"proxy\"} - go_memory_classes_heap_stacks_bytes{job=\"proxy\"} - go_memory_classes_os_stacks_bytes{job=\"proxy\"}",
          "legendFormat": "runtime metadata + other"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Goroutines",
      "description": "net/http uses about one goroutine per client connection, plus some per backend connection.",
      "id": 8,
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 41
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 8,
            "showPoints": "never",
            "stacking": {
              "mode": "none"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "go_sched_goroutines_goroutines{job=\"proxy\"}",
          "legendFormat": "goroutines"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Allocation rate and GC heap goal",
      "description": "More allocation means more GC work. With GOGC=100 the heap may grow to ~2x live data before a GC.",
      "id": 9,
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 49
      },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 8,
            "showPoints": "never",
            "stacking": {
              "mode": "none"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "rate(go_gc_heap_allocs_bytes{job=\"proxy\"}[$__rate_interval])",
          "legendFormat": "allocated per second"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "go_gc_heap_goal_bytes{job=\"proxy\"}",
          "legendFormat": "heap goal (GC starts here)"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "GC: cycles per second and share of CPU",
      "description": "",
      "id": 10,
      "datasource": {
