[Unit]
Description=Reverse proxy under test
After=network.target

[Service]
User=deploy
# -metrics: /metrics for Prometheus (reached through the SSH tunnel). -pprof: profiles. Both localhost only.
ExecStart={{ base_dir }}/proxy -from 0.0.0.0:80 -to {{ backend_ip }}:3000 -metrics 127.0.0.1:9091 -pprof 127.0.0.1:6060
LimitNOFILE=65535
AmbientCapabilities=CAP_NET_BIND_SERVICE
Restart=no

[Install]
WantedBy=multi-user.target
